# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# per-machine docker overrides (e.g. a different postgres tag you already pulled)
docker-compose.override.yml

# supplier import working area — staging dumps and the review page are
# regenerable third-party data; only scripts/import/seleccion.json is committed
/data/

# graphify knowledge graph — regenerate with `/graphify` (Claude Code) or the
# `graphify` CLI; sidecar files record a machine-local Python interpreter path
# and are meaningless on another machine, so this stays local, not committed
/graphify-out/

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client — regenerated on install (postinstall)
/src/generated/

# Playwright artifacts
test-results/
playwright-report/
