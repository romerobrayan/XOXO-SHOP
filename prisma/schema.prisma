// SECRETO (antes XOXO Store) — catalog, inventory, orders, payments.
// Modeling rationale: docs/XOXO_TECHNICAL_SPEC.md §6. This file is the only
// copy of the schema; the spec describes the decisions behind it, not the DDL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7) and the runtime
// adapter in src/lib/db.ts — never here.
datasource db {
  provider = "postgresql"
}

// ─── Catalog ────────────────────────────────────────────────

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique // "Lovense", "Sen Intimo", "Pretty Love"
  slug     String    @unique
  logoUrl  String?
  products Product[]
}

model Category {
  id       String     @id @default(cuid())
  name     String // "Lencería", "Cosmética íntima", "Juguetería"
  slug     String     @unique
  position Int        @default(0)
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String        @db.VarChar(100)
  description String?       @db.Text
  status      ProductStatus @default(DRAFT)

  // Two writers, one column: a human typing "11362" in the panel (Zod caps that
  // at 40) and promote-core copying a namespaced staging ref straight in —
  // "climax:<handle>" is a full slug and runs past 40. The column has to fit
  // the widest writer; stagedProductSchema caps the pipeline at the same 80.
  supplierRef String? @db.VarChar(80) // "11362" | "climax:lubricante-de-silicona-30-ml-sen-intimo"

  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  options  ProductOption[]
  variants ProductVariant[]
  specs    ProductSpec[]
  media    ProductMedia[]

  // Denormalized for catalog cards — avoids an aggregate per render.
  // Recalculated whenever a variant price changes.
  minPriceCents Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  stagedSources SupplierStagingProduct[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([brandId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// An axis of choice. Zero rows is valid and common.
model ProductOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name     String // "Talla" | "Color" | "Presentación"
  position Int    @default(0)

  values ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId])
}

model ProductOptionValue {
  id       String        @id @default(cuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  value    String // "S" | "Negro" | "30 ml"
  hex      String? // set for colors, null otherwise — drives UI swatches
  position Int     @default(0)

  variantValues VariantOptionValue[]
  media         ProductMedia[]

  @@unique([optionId, value])
  @@index([optionId])
}

// The sellable unit. Always at least one per product.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String  @unique @db.VarChar(60)
  // Bounds enforced by a CHECK constraint added by hand in this field's
  // migration (Wompi's Agregador-model limits — see PRICE_MIN_CENTS /
  // PRICE_MAX_CENTS in src/features/products/schemas.ts for the sourcing).
  priceCents     Int
  compareAtCents Int? // strikethrough price for promotions
  barcode        String?

  // Sorted, joined option value IDs. Enforces combination uniqueness,
  // which Prisma cannot express over a relation. "" for option-less products.
  optionKey String @default("")

  // Inventory. available = stockOnHand - stockReserved
  stockOnHand   Int @default(0)
  stockReserved Int @default(0)
  lowStockAt    Int @default(3)

  isActive     Boolean              @default(true)
  optionValues VariantOptionValue[]
  movements    InventoryMovement[]
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, optionKey])
  @@index([productId])
  @@index([sku])
}

model VariantOptionValue {
  variantId     String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

// Display-only attributes that do NOT vary within a product.
// "Material: silicona médica" · "Conectividad: Bluetooth" · "Contenido: 130 ml"
model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label    String
  value    String
  position Int    @default(0)

  @@index([productId, position])
}

// One ordered reel per product, mixing images and video. Hosted on
// Cloudinary — never in the repo, never in transactional email.
model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Nullable: null = applies to the whole product.
  // Set = show when that option value is selected (color-specific photography).
  optionValueId String?
  optionValue   ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  type      MediaType @default(IMAGE)
  url       String
  // Cover frame for videos — required in practice for type VIDEO so the
  // gallery never autoplays; playback is tap-to-play, muted by default.
  posterUrl String?
  alt       String
  position  Int       @default(0)

  // One row per delivery URL within a product — the invariant the import
  // always kept by hand; the panel's content-addressed uploads lean on the
  // database enforcing it under concurrency.
  @@unique([productId, url])
  @@index([productId, position])
}

enum MediaType {
  IMAGE
  VIDEO
}

// ─── Supplier staging (Bloque I) ────────────────────────────
//
// Everything the two suppliers publish, normalized to the staging shape,
// living where the DEPLOYED panel can read it: the owner curates in
// /admin/proveedores and only "Publicar" touches the real catalog. Fed by
// the import scripts (fetch → npm run import:stage); the full normalized
// product travels in `payload` and is Zod-validated on read. This is
// internal working material — the storefront never queries this table.

model SupplierStagingProduct {
  id          String @id @default(cuid())
  supplierRef String @unique // "distrisex:99363" | "climax:liguero-lucy-rojo"
  supplier    String // "distrisex" | "climax"

  name  String
  brand String?

  suggestedCategorySlug String?

  // Reference data, never the sale price: DistriSex publishes wholesale and
  // Climax is a retail competitor. The sale price is decided at publish time.
  supplierPriceCents   Int
  suggestedRetailCents Int?
  priceVariesByVariant Boolean @default(false)

  optionCount     Int     @default(0)
  imageCount      Int     @default(0)
  // First supplier image, hotlinked ONLY inside the panel while curating —
  // published products always re-host on Cloudinary instead.
  previewImageUrl String?
  // Supplier availability at fetch time — reference only.
  available       Boolean @default(true)

  // The complete StagedProduct (src/features/import/staging.ts), validated
  // with stagedProductSchema before any promote reads it.
  payload Json

  // normalizeKey(name + brand + supplier categories) — what search matches.
  searchText String

  fetchedAt DateTime
  status    StagingStatus @default(PENDING)

  publishedProductId String?
  publishedProduct   Product?  @relation(fields: [publishedProductId], references: [id], onDelete: SetNull)
  publishedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplier, status])
  @@index([status, suggestedCategorySlug])
  @@index([publishedProductId])
}

enum StagingStatus {
  PENDING
  PUBLISHED
}

// ─── Inventory ──────────────────────────────────────────────

// Append-only ledger. The stock columns on ProductVariant are the running
// balance; this explains how it got there. Essential for a store migrating
// off manual DM-based tracking.
model InventoryMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  delta  Int // negative = stock leaving
  reason MovementReason
  note   String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
}

enum MovementReason {
  PURCHASE // restocked from supplier
  SALE
  RETURN
  MANUAL_ADJUST // physical count correction
  DAMAGE
  RESERVATION
  RESERVATION_RELEASE
}

// ─── Orders ─────────────────────────────────────────────────

model Customer {
  id        String    @id @default(cuid())
  email     String    @unique
  fullName  String
  phone     String
  orders    Order[]
  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id         String    @id @default(cuid())
  // Nullable because guest checkout is mandatory: a guest order snapshots its
  // delivery address here with no Customer row behind it. SetNull (not
  // Cascade) so deleting a customer never deletes the address history that
  // orders reference.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  fullName     String
  phone        String
  documentType DocumentType // required for Colombian invoicing
  documentId   String
  department   String // Antioquia
  city         String // Medellín
  line1        String
  neighborhood String?
  notes        String?

  isDefault Boolean @default(false)
  orders    Order[]

  @@index([customerId])
}

enum DocumentType {
  CC // cédula de ciudadanía
  CE // cédula de extranjería
  NIT
  PP // pasaporte
}

// ─── Domicilios ─────────────────────────────────────────────
// El costo del domicilio depende de la ubicación, no del pedido: dentro de
// Medellín varía por zona, el área metropolitana tiene su propia tarifa y el
// resto del país otra. La clienta define esas zonas desde /admin/domicilios;
// el checkout resuelve la tarifa contra ellas y la congela en
// Order.shippingCents al crear el pedido.
model ShippingZone {
  id   String           @id @default(cuid())
  name String
  kind ShippingZoneKind

  // Obligatorio para SPECIFIC y GENERAL, null para NATIONAL: una zona
  // específica y el "resto de" viven dentro de un departamento; el domicilio
  // nacional es justamente el que no lo tiene.
  department String?

  // Centavos, como todo el dinero del proyecto (CLAUDE.md regla 1). 0 es
  // válido: es como se declara un domicilio gratis.
  priceCents Int

  // Nota que ve la clienta en el checkout ("Entrega el mismo día").
  note String?

  // Desactivar en vez de borrar conserva la zona para volver a activarla sin
  // recargar la lista de ubicaciones.
  isActive Boolean @default(true)

  areas ShippingZoneArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, kind])
}

enum ShippingZoneKind {
  SPECIFIC // ubicaciones concretas: los barrios o municipios listados en areas
  GENERAL // resto del departamento — el "domicilio general" del área metropolitana
  NATIONAL // resto de Colombia; el último escalón, sin departamento
}

// Una ubicación cubierta por una zona: lo que la clienta escribió (label) y su
// forma normalizada (matchKey), que es contra la que el checkout compara la
// ciudad o el barrio del comprador.
model ShippingZoneArea {
  id     String       @id @default(cuid())
  zoneId String
  zone   ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  label    String
  matchKey String

  // Copiado de la zona al guardar (las areas se reescriben completas en cada
  // edición, así que no se desincroniza) para que la base pueda garantizar lo
  // que importa: una misma ubicación no puede estar en dos zonas con precios
  // distintos.
  department String

  @@unique([department, matchKey])
  @@index([zoneId])
}

model Order {
  id          String @id @default(cuid())
  // Short, human-readable code the customer quotes on WhatsApp — "SECRETO-7F3K2M".
  // Customer-facing, so it carries the new brand, not the repository's name.
  orderNumber String @unique

  // One UUID per checkout attempt, generated client-side. A double-tap on
  // "Confirmar pedido" or a retried request finds the existing order via
  // the unique index instead of creating (and reserving stock for) a second.
  idempotencyKey String? @unique

  // Nullable: guest checkout is mandatory in this category.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  addressId  String?
  address    Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)

  guestEmail String?
  guestPhone String?

  status   OrderStatus @default(PENDING)
  currency String      @default("COP")

  subtotalCents Int
  shippingCents Int @default(0)
  discountCents Int @default(0)
  totalCents    Int

  // Snapshot de la zona que fijó shippingCents, como todo lo demás del pedido
  // (CLAUDE.md regla 4): renombrar o borrar una zona no puede reescribir lo
  // que se le cobró a este comprador. Null en pedidos anteriores a las zonas.
  shippingZoneName String?

  // Discretion is a functional requirement, not a preference.
  discreetPackaging Boolean @default(true)

  items     OrderItem[]
  payments  Payment[]
  movements InventoryMovement[]

  // Reservations expire so abandoned carts release stock.
  reservationExpiresAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?
  shippedAt DateTime?

  @@index([status, createdAt])
  @@index([customerId])
}

enum OrderStatus {
  PENDING // created, awaiting payment
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// Snapshot of the purchase. Catalog data is copied, not joined,
// so later edits never rewrite history.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName     String
  brandName       String?
  variantSku      String
  // Human-readable at purchase time, e.g. "Talla: S · Color: Negro".
  // Empty string for option-less products.
  variantLabel    String
  optionsSnapshot Json?
  imageUrl        String?

  unitPriceCents Int
  quantity       Int
  totalCents     Int

  @@index([orderId])
}

// ─── Payments ───────────────────────────────────────────────

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider          String // "wompi" | "payu" | "mock" — never "stripe", see spec §2
  providerReference String?        @unique
  // Null between initiating an ONLINE payment and its first webhook: the
  // gateway's checkout picks the actual rail (CARD / PSE / NEQUI…) and only
  // the event knows it. Contra entrega and manual transfer set it at creation.
  method            PaymentMethod?
  status            PaymentStatus  @default(PENDING)

  amountCents Int

  rawPayload Json? // full provider response, for reconciliation and disputes

  // Manual transfer flow: customer uploads a receipt, an advisor approves in the
  // admin panel. Nothing ships until status is APPROVED.
  proofOfPaymentUrl String?
  verifiedAt        DateTime?
  verifiedBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

enum PaymentMethod {
  CARD
  PSE
  NEQUI
  DAVIPLATA
  BANCOLOMBIA_TRANSFER
  CASH_ON_DELIVERY // contra entrega — already the client's working channel
  BANK_TRANSFER_MANUAL // customer transfers, uploads proof, an advisor verifies
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION // proof uploaded, waiting on a human to confirm
  APPROVED
  DECLINED
  VOIDED
  ERROR
  REFUNDED
}

// ─── Admin authentication ───────────────────────────────────
//
// Owned by better-auth, not by us: the shape below is the library's core
// schema, so it is the one place in this file where the columns are not ours
// to redesign. Field names and nullability must match what the adapter
// expects or it fails at runtime rather than at build time.
//
// These are STAFF accounts for the admin panel — the shop owner and her
// advisors. Customers are `Customer`, have no login, and never appear here:
// guest checkout is mandatory (CLAUDE.md rule 3), so a buyer never has
// credentials to store.

model User {
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime

  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id         String @id
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Set for the credential provider only: the hashed password. Never the
  // plaintext, and never logged.
  password String?

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}
